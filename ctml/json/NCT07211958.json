    "prior_treatment_requirements": [
        "Key Inclusion Criteria:",
        "* Participants must have newly diagnosed and previously untreated AML and be candidates for intensive chemotherapy.",
        "* Presence of an NPM1 mutation.",
        "* Eastern Cooperative Oncology Group performance status \u22642 (\u22641 if \\>65 years old); Karnofsky or Lansky \u226540.",
        "* Have a life expectancy of \u22653 months as judged by the Investigator.",
        "* Negative serum pregnancy test.",
        "* Adequate liver, kidney, and cardiac function.",
        "Exclude - Key Exclusion Criteria:",
        "Exclude - * Diagnosis of active acute promyelocytic leukemia.",
        "Exclude - * Active central nervous system disease.",
        "Exclude - * Fridericia's corrected QT interval (QTcF) \\>450 milliseconds at screening, diagnosis or suspicion of Long QT syndrome or family history of Long QT syndrome.",
        "Exclude - * Any gastrointestinal (GI) issue of the upper GI tract likely to affect oral drug absorption or ingestion.",
        "Exclude - * Any concurrent malignancy requiring active therapy (except breast or prostate cancer stable on or responding to endocrine therapy).",
        "Exclude - * Inability to swallow oral medication.",
        "Exclude - * Pregnant or nursing females.",
        "Exclude - * Participant has known active or chronic hepatitis B or active hepatitis C (HCV) infection or human immunodeficiency virus (HIV)-positive with detectable viral load.",
        "Exclude - Note: Additional inclusion/exclusion criteria may apply, per protocol."
    ],
