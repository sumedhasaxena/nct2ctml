    "prior_treatment_requirements": [
        "Inclusion Criteria:",
        "* Child-Pugh Class A or B",
        "* Patients with suspected hepatocellular carcinoma or residual/recurrent hepatocellular carcinoma of 4 cm or less on MDCT, CEUS, or MRI performed within the last 60 days or Patients with suspected metastatic liver cancer of 4 cm or less on MDCT, CEUS, or MRI performed within the last 60 days, for whom microwave thermal ablation is being considered",
        "Exclude - Exclusion Criteria:",
        "Exclude - * In cases where there are three or more malignant liver tumors",
        "Exclude - * When the maximum size of the tumor exceeds 4 cm",
        "Exclude - * Diffuse infiltrative type of cancer with unclear tumor boundaries",
        "Exclude - * When the tumor is adhered to the central hepatic portal vein, hepatic vein, or bile duct by 5 mm or more",
        "Exclude - * Severe liver failure (Child-Pugh Class C)",
        "Exclude - * In cases of vascular invasion by malignant liver tumors",
        "Exclude - * Severe coagulopathy (platelet count below 50,000/mm\u00b3 or INR prolonged by more than 50%)",
        "Exclude - * In cases of multiple extrahepatic metastases",
        "Exclude - * Situations where it is highly unlikely to obtain appropriate data for research purposes"
    ],
    "short_title": "Clinical Effectiveness of Microwave Ablation Using Starwave Microwave Generator for Hepatic Malignancies",
